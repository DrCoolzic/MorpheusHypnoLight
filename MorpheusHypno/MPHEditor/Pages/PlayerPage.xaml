<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MPEditor.ViewModel"
             xmlns:converters="clr-namespace:MPMaui.Converters;assembly=MPMaui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:PlayerViewModel"
             x:Class="MPEditor.View.PlayerPage"
             Style="{StaticResource GradientPageStyle}"
             Title="Play Sequence">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- All converters are declared globally in App.xaml -->
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Display Sequence Info -->
        <Border Grid.Row="0" IsVisible="{Binding DisplayText}"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Opacity="{AppThemeBinding Light=1, Dark=0.8}"
                Padding="0" Margin="10,10,10,0" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStopCollection>
                        <GradientStop Color="{Binding GradientStops[0]}" Offset="0.0" />
                        <GradientStop Color="{Binding GradientStops[1]}" Offset="0.5" />
                        <GradientStop Color="{Binding GradientStops[2]}" Offset="1.0" />
                    </GradientStopCollection>
                </LinearGradientBrush>
            </Border.Background>
            <Grid RowDefinitions="auto,auto,auto,auto, *" Padding="10" ColumnDefinitions="2*">
                <!--Title-->
                <Label Grid.Row="0"
                       Text="{Binding Name, Converter={StaticResource StringCleanupConverter}}"
                       Style="{StaticResource DescriptionTitleLabel}"
                       FontSize="20" HorizontalOptions="Start" Margin="0,5,0,5"
                       VerticalOptions="Center" />

                <!--Metadata (Author, Version, CreatedAt) - only visible if at least one has a value-->
                <HorizontalStackLayout Grid.Row="1" IsVisible="{Binding HasMetadata}" Margin="0,0,0,5">
                    <Label Text="Author:" FontAttributes="Bold" IsVisible="{Binding Author, Converter={StaticResource StringToBoolConverter}}" Margin="0,0,5,0"/>
                    <Label Text="{Binding Author}" IsVisible="{Binding Author, Converter={StaticResource StringToBoolConverter}}" Margin="0,0,15,0"/>
                    
                    <Label Text="Version:" FontAttributes="Bold" IsVisible="{Binding Version, Converter={StaticResource StringToBoolConverter}}" Margin="0,0,5,0"/>
                    <Label Text="{Binding Version}" IsVisible="{Binding Version, Converter={StaticResource StringToBoolConverter}}" Margin="0,0,15,0"/>
                    
                    <Label Text="Created:" FontAttributes="Bold" IsVisible="{Binding CreatedAt, Converter={StaticResource NullToBoolConverter}}" Margin="0,0,5,0"/>
                    <Label Text="{Binding FormattedCreatedAt}" IsVisible="{Binding CreatedAt, Converter={StaticResource NullToBoolConverter}}"/>
                </HorizontalStackLayout>

                <!-- Time, Category, Level, Audio -->
                <Grid Grid.Row="2" RowSpacing="5"
                      ColumnDefinitions="70, 30, *, 40, 40"
                      RowDefinitions="auto,auto,auto,auto,auto">
                    <Label Grid.Row="0" Grid.Column="0" HorizontalOptions="Start" TextColor="Black"
                           Text="Time:" />
                    <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding FormattedEndTime, StringFormat='{0:0.#}'}"
                           Margin="5,0,5,0"
                           Style="{StaticResource DescriptionTitleLabel}"/>

                    <Label Grid.Row="1" Grid.Column="0" HorizontalOptions="Start" TextColor="Black"
                           Text="Category:"/>
                    <Image Grid.Row="1" Grid.Column="1" 
                           Style="{StaticResource IconImage}"
                           Source="{Binding Category, Converter={StaticResource GenericImageConverter}, ConverterParameter='Category'}" />
                    <Label Grid.Row="1" Grid.Column="2" HorizontalOptions="Start"
                           Text="{Binding CategoryName}" Margin="5,0,10,0"
                           Style="{StaticResource DescriptionTitleLabel}"/>

                    <Label Grid.Row="2" Grid.Column="0" HorizontalOptions="Start"  TextColor="Black"
                           Text="Level:"/>
                    <Image Grid.Row="2" Grid.Column="1" 
                           Style="{StaticResource IconImage}"
                           Source="{Binding Level, Converter={StaticResource GenericImageConverter}, ConverterParameter='Level'}" />
                    <Label Grid.Row="2" Grid.Column="2"
                           Text="{Binding LevelName}" Margin="5,0,10,0" Style="{StaticResource DescriptionTitleLabel}"></Label>

                    <Label Grid.Row="3" Grid.Column="0" HorizontalOptions="Start" TextColor="Black"
                           Text="Audio:"/>
                    <Image Grid.Row="3" Grid.Column="1" 
                           Style="{StaticResource IconImage}"
                           Source="{Binding DmSequence.Audio, Converter={StaticResource GenericImageConverter}, ConverterParameter='Audio'}" />

                    <Label Grid.Row="4" Grid.Column="0" HorizontalOptions="Start" TextColor="Black"
                           Text="Rating:"
                           VerticalOptions="Center"/>
                    <ContentView Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                 Content="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}" />
                    <Image Grid.Row="4" Grid.Column="3" Style="{StaticResource IconImage}" Source="minus_sign.png" Margin="5,0,5,0" WidthRequest="40">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:PlayerViewModel}}, x:DataType=viewmodel:PlayerViewModel, Path=MinusRatingCommand}"
                                           CommandParameter="{Binding .}"/>
                        </Image.GestureRecognizers>
                    </Image>
                    <Image Grid.Row="4" Grid.Column="4" Style="{StaticResource IconImage}" Source="plus_sign.png" Margin="5,0,5,0" WidthRequest="40">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:PlayerViewModel}}, x:DataType=viewmodel:PlayerViewModel, Path=PlusRatingCommand}"
                                           CommandParameter="{Binding .}"/>
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>

                <!-- Detail -->
                <ScrollView Grid.Row="4">
                    <Label Grid.Row="0" Text="{Binding Detail}"  Margin="0,20,0,0" Style="{StaticResource HtmlDetailLabel}" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- Alternative Display Clock -->
        <Border Grid.Row="0" IsVisible="{Binding DisplayClock}"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=#44b, Dark=#303030}"
                Margin="10" >
            <Grid IsVisible="{Binding DisplayClock}"
                  Grid.ColumnDefinitions="*"
                  Grid.RowDefinitions="auto, auto,auto,auto,auto,auto, Auto, Auto, *">

                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Text="{Binding Name, Converter={StaticResource StringCleanupConverter}}"
                    Style="{StaticResource DescriptionTitleLabel}" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                    FontSize="30" FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Margin="10">
                </Label>
                <Label Grid.Row="1" Grid.Column="0" 
                   Text="Total Time"
                   Margin="0,30,0,-10"
                   FontSize="24" HorizontalOptions="Center"/>
                <Label Grid.Row="2" Grid.Column="0" 
                   Text="{Binding FormattedEndTime}"
                   FontSize="40" HorizontalOptions="Center"
                   FontAttributes="Bold"/>
                <Label Grid.Row="3" Grid.Column="1" 
                   Text="Elapsed Time"
                   Margin="0,20,0,-10"
                   FontSize="24" HorizontalOptions="Center"/>
                <Label Grid.Row="4" Grid.Column="1" 
                   Text="{Binding FormattedPlayerCurrentTime}" 
                   FontSize="40" HorizontalOptions="Center"
                   FontAttributes="Bold"/>
                <Label Grid.Row="5" Grid.Column="1" 
                   Text="Remaining Time"
                   Margin="0,20,0,-10"
                   FontSize="24" HorizontalOptions="Center"/>
                <Label Grid.Row="6" Grid.Column="1"
                   Text="{Binding FormattedPlayerRemainingTime}" 
                   FontSize="40" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Grid.Row="7" Grid.Column="1" 
                   Text="Frequencies"
                   Margin="0,20,0,-10"
                   FontSize="24" HorizontalTextAlignment="Center"/>
                <Label Grid.Row="8" Grid.Column="1"
                   Text="{Binding Frequencies}" 
                   FontSize="40" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Audio and Brightness -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <HorizontalStackLayout Grid.Column="0" IsVisible="{Binding HasAudio}">
                <Label Text="Audio"  Margin="5,0,5,0" VerticalOptions="Center"/>
                <Switch Grid.Column="1" IsToggled="True" MinimumWidthRequest="40"
                        OnColor="#99f"
                        x:Name="AudioSwitch"
                        Toggled="OnAudioToggled"/>
                <Image Source="{Binding AudioIcon}" Margin="5,0,5,0"
                       WidthRequest="24" HeightRequest="24" />
            </HorizontalStackLayout>

            <Label Grid.Column="1" Text="Brightness" FontSize="12" Margin="5,5,5,5" VerticalOptions="Center" />
            <Slider Grid.Column="2" x:Name="BrightnessSlider"
                    VerticalOptions="Center"
                    MaximumTrackColor="#00BBFF"
                    MinimumTrackColor="#0066FF"
                    Minimum="0" Maximum="100"
                    Value="{Binding BrightnessValue}" />
        </Grid>

        <!-- Time & slider -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Text="{Binding FormattedPlayerCurrentTime, StringFormat='{0:0.#}'}"
                   Margin="5,5,5,5" VerticalTextAlignment="Center" FontSize="13"/>
            <Slider Grid.Column="1" x:Name="TimerSlider"
                    MaximumTrackColor="#00BBFF"
                    MinimumTrackColor="#0066FF"
                    Margin="5,0,5,0" Minimum="0" Maximum="{Binding PlayerDuration}"
                    Value="{Binding PlayerCurrentPosition, Mode=TwoWay}" 
                    DragStarted="Slider_DragStarted"
                    DragCompleted="Slider_DragCompleted"/>
            <Label Grid.Column="2" Text="{Binding FormattedEndTime, StringFormat='{0:0.#}'}"
                    Margin="5,0,5,0" VerticalTextAlignment="Center" FontSize="13"/>
        </Grid>

        <!-- Player -->
        <Grid Grid.Row="3" Margin="10,0,10,0" ColumnDefinitions="auto,auto,*,auto,auto,auto,*,auto,auto">
            <!-- Delay button -->
            <ImageButton Grid.Column="0" WidthRequest="45" HeightRequest="48" Padding="5"
                         VerticalOptions="Center" HorizontalOptions="Start"
                         Source="{Binding DelayIcon}"
                         Command="{Binding ToggleDelayCommand}"
                         ToolTipProperties.Text="Switch Start Delay"
                         BorderColor="Blue" BorderWidth="2" CornerRadius="5" BackgroundColor="#9999FF">
            </ImageButton>

            <!-- Countdown label -->
            <Label Grid.Column="1" 
                   Text="{Binding DelayCountdown}"
                   WidthRequest="40"
                   FontSize="24" FontAttributes="Bold"
                   TextColor="Blue"
                   VerticalOptions="Center" HorizontalOptions="Start"
                   Margin="10,0,0,0"/>

            <!-- playback control -->
            <Button Grid.Column="3" 
                    Padding="10"
                    ImageSource="{Binding LoopIcon}" 
                    BackgroundColor="#9999FF" BorderColor="Blue" BorderWidth="2"
                    WidthRequest="45" HeightRequest="48"
                    Command="{Binding LoopCommand}" Margin="5,5,5,5"/>
            <Button Grid.Column="4" 
                    Padding="10"
                    WidthRequest="45" HeightRequest="48"
                    BackgroundColor="#9999FF" BorderColor="Blue" BorderWidth="2"
                    ImageSource="{Binding PlayerState, Converter={StaticResource PlayImageConverter}, ConverterParameter='Player'}" 
                    Command="{Binding PlayPausePlayerCommand}" Margin="5,5,5,5" />
            <Button Grid.Column="5" 
                    Padding="12"
                    ImageSource="stop.png" 
                    BackgroundColor="#9999FF" BorderColor="Blue" BorderWidth="2"
                    WidthRequest="45" HeightRequest="48"
                    Command="{Binding StopPlayerCommand}" Margin="5,5,5,5"/>

            <!-- Language Icon -->
            <ImageButton Grid.Column="7" Margin="0,0,5,0" WidthRequest="45" HeightRequest="48" Padding="3"
                         VerticalOptions="Center" HorizontalOptions="End"
                         Source="{Binding CurrentLanguageIcon}"
                         Command="{Binding ShowLanguagePickerCommand}"
                         ToolTipProperties.Text="Change language"
                         BorderColor="Blue" BorderWidth="2" CornerRadius="5" BackgroundColor="#9999FF">
            </ImageButton>

            <!-- Bluetooth & Activity -->
            <ImageButton Grid.Column="8" Margin="0" WidthRequest="45" HeightRequest="48" Padding="3" VerticalOptions="Center"
                         Source="{Binding DmIcon}" HorizontalOptions="End"
                         BorderColor="Blue" BorderWidth="2" CornerRadius="5" BackgroundColor="#9999FF">
            </ImageButton>
            <ActivityIndicator Grid.Column="8" 
                               IsRunning="{Binding IsConnecting}"
                               HeightRequest="30" 
                               WidthRequest="30"
                               BackgroundColor="Transparent"
                               Margin="0,0,5,0"
                               HorizontalOptions="End">
            </ActivityIndicator>

        </Grid>

    </Grid>
</ContentPage>
