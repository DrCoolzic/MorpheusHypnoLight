<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPHEditor.ViewModels;assembly=MPHEditor"
             x:Class="MPHEditor.Pages.MainPage"
             x:DataType="vm:MainViewModel">

       <Grid RowDefinitions="Auto, *">
              <!-- Bluetooth Status Icon -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                     <Label Grid.Column="0" Text="{Binding BleStatusMessage, StringFormat='BLE Status: {0}'}"
                            FontSize="14"
                            VerticalOptions="Center"
                            HorizontalOptions="Start" />
                     <ImageButton Grid.Column="2" Margin="5,0,5,0" WidthRequest="50" HeightRequest="50" Padding="5" VerticalOptions="Center"
                            Source="{Binding BleIcon}"
                            Command="{Binding ToggleBleCommand}"
                            ToolTipProperties.Text="Start/Stop MorpheusHypno search"
                            BorderColor="Blue" BorderWidth="2" CornerRadius="5" 
                            BackgroundColor="#9999FF" />

                     <ActivityIndicator Grid.Column="2" 
                            IsRunning="{Binding IsConnecting}"
                            HeightRequest="20" 
                            BackgroundColor="Transparent"
                            WidthRequest="35"
                            HorizontalOptions="Center">
                            <ActivityIndicator.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleBleCommand}" />
                            </ActivityIndicator.GestureRecognizers>
                     </ActivityIndicator>
              </Grid>
    </Grid>
</ContentPage>
