<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPHEditor.ViewModels;assembly=MPHEditor"
             x:Class="MPHEditor.Pages.MainPage"
             x:DataType="vm:MainViewModel">
    <VerticalStackLayout Spacing="25" Padding="30">
        <Label Text="Morpheus HypnoLight Player"
               FontSize="24"
               HorizontalOptions="Center" />
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
              <Button Text="Connect"
                     Command="{Binding ConnectCommand}"
                     HorizontalOptions="Center" />
              <Button Text="Disconnect"
                     Command="{Binding DisconnectCommand}"
                     HorizontalOptions="Center" />
        </HorizontalStackLayout>

        <Label Text="{Binding IsConnecting, StringFormat='Connecting: {0}'}"
               FontSize="14"
               HorizontalOptions="Center" />
        <Label Text="{Binding IsConnected, StringFormat='Connected: {0}'}"
               FontSize="14"
               HorizontalOptions="Center" />
        <Label Text="{Binding BleStatusMessage, StringFormat='BLE Status: {0}'}"
               FontSize="14"
               HorizontalOptions="Center" />
        <Label Text="{Binding CurrentSequence, StringFormat='Current Sequence: {0}'}"
               FontSize="14"
               HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="Load Sequence"
                    Command="{Binding LoadSequenceCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Play"
                    Command="{Binding PlayCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Pause"
                    Command="{Binding PauseCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Stop"
                    Command="{Binding StopCommand}"
                    HorizontalOptions="Center" />
            <Label Text="{Binding CommandOpcode, StringFormat='Command Opcode: {0}'}"
                   FontSize="14"
                   HorizontalOptions="Center" />
            <Label Text="{Binding CommandResultCode, StringFormat='Command Result Code: {0}'}"
                   FontSize="14"
                   HorizontalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="Set Player"
                    Command="{Binding SetPlayerCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Start Player"
                    Command="{Binding StartPlayerCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Pause Player"
                    Command="{Binding PausePlayerCommand}"
                    HorizontalOptions="Center" />
            <Button Text="Stop Player"
                    Command="{Binding StopPlayerCommand}"
                    HorizontalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Label Text="{Binding PlayerState, StringFormat='Player State: {0}'}"
                   FontSize="14"
                   HorizontalOptions="Center" />
            <Label Text="{Binding CurrentPositionText, StringFormat='Position: {0}'}"
                   FontSize="14"
                   HorizontalOptions="Center" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
