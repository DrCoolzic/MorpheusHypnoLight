<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:MPHEditor.Pages;assembly=MPHEditor"
       x:Class="MPHEditor.AppShell">

    <FlyoutItem Title="Home">
        <ShellContent Title="Morpheus Hypno"
                      ContentTemplate="{DataTemplate pages:MainPage}"
                      Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem x:Name="RealtimeEditorFlyoutItem" Title="Realtime Editor" IsVisible="False">
        <ShellContent Title="Realtime Editor"
                      ContentTemplate="{DataTemplate pages:RealtimeEditorPage}"
                      Route="RealtimeEditorPage" />
    </FlyoutItem>

    <FlyoutItem Title="Test">
    <ShellContent Title="Test"
                    ContentTemplate="{DataTemplate pages:TestPage}"
                    Route="TestPage" />
    </FlyoutItem>

</Shell>
