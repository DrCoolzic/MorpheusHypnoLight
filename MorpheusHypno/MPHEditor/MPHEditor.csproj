<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>

    <OutputType>Exe</OutputType>
    <RootNamespace>MPHEditor</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>MPHEditor</ApplicationTitle>
    <ApplicationId>com.drcoolzic.mpheditor</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">1.0.0.0</ApplicationDisplayVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Add these lines for XAML compilation -->
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <EnableDefaultMauiItems>true</EnableDefaultMauiItems>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

  </PropertyGroup>

  <ItemGroup>
      <!-- App Icon -->
      <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#00649F" />

      <!-- Splash Screen -->
      <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
      
      <!-- Windows-specific splash screen PNG (workaround for MSIX packaging issue) -->
      <None Include="Resources\Splash\splash.png" Condition="Exists('Resources\Splash\splash.png')">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <Link>splashSplashScreen.png</Link>
      </None>

      <!-- Images -->
      <MauiImage Include="Resources\Images\*" />

      <!-- Custom Fonts -->
      <MauiFont Include="Resources\Fonts\OpenSans-Semibold.ttf">
          <Alias>OpenSansSemibold</Alias>
      </MauiFont>

      <!-- Font Assets for Android - Exclude fonts already defined as MauiFont -->
      <MauiAsset Include="Resources\Fonts\*.ttf" Exclude="Resources\Fonts\OpenSans-Semibold.ttf" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Plugin.BLE" Version="3.2.1" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MPHCore\MPHCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\TestPage.xaml.cs">
      <DependentUpon>TestPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\RealtimeEditorPage.xaml.cs">
      <DependentUpon>RealtimeEditorPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Pages\TestPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
